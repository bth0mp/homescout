# --- Core -------------------------------------------------------------------
# SQLite file. In Docker this points into the mounted volume.
DATABASE_PATH=./data/homescout.db

# Public origin, used to render share links. No trailing slash.
APP_URL=http://localhost:3000

# Contact string sent as the User-Agent to Nominatim + Census. Their usage
# policy requires a real identifier. Change this before you deploy.
GEOCODER_CONTACT=homescout (you@example.com)

# --- Feature 3: crime data --------------------------------------------------
# FBI Crime Data Explorer. Free key from https://api.data.gov/signup/
# Without it the FBI provider is skipped and only deep links are shown.
FBI_CDE_API_KEY=

# Optional Socrata app token. City open-data portals work without one but
# throttle aggressively. Free from any Socrata portal's developer settings.
SOCRATA_APP_TOKEN=

# --- Feature 2: optional licensed listing data (OFF by default) -------------
# Leave blank unless you hold a license. Presence of a key enables enrichment.
ENABLE_LISTING_ENRICHMENT=false
ATTOM_API_KEY=
RENTCAST_API_KEY=
BRIDGE_API_KEY=
